<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:macro name="car_camera" params="prefix">

        <link name="camera_link">
            <visual>
                <geometry>
                    <box size="0.05 0.05 0.05"/>
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.2 0.2 0.2 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.05 0.05 0.05"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.05"/>
                <origin xyz=" 0 0 0"/>
                <inertia ixx="0.000001" ixy="0" ixz="0"
                         iyy="0.000001" iyz="0"
                         izz="0.000001"/>
            </inertial>
        </link>

        <link name="camera_optical_link"/>

        <joint name="camera_joint" type="fixed">
            <parent link="base_link"/>
            <child link="camera_link"/>
            <origin xyz="0.32 .051   0.075" rpy="0 0 0"/>
        </joint>

        <!-- Without this, gz-sim's URDF->SDF conversion performs "fixed
             joint reduction": any link connected via a fixed joint gets
             merged into its parent (base_link), taking its attached
             sensor with it. Confirmed directly via `gz model -m car1
             link`: base_link's mass (0.56kg) is exactly
             chassis(0.5) + camera(0.05) + imu(0.01)  all three fixed-
             jointed links had already been lumped in, sensors and all,
             which is why the camera/imu sensors were showing up
             registered on base_link instead of their intended links.
             This tag is required on every fixed joint whose child link
             must survive as an independent link (i.e. anything carrying
             a sensor) continuous joints (the wheels) are unaffected
             either way. -->
        <gazebo reference="camera_joint">
            <disableFixedJointLumping>true</disableFixedJointLumping>
        </gazebo>

        <joint name="camera_optical_joint" type="fixed">
            <parent link="camera_link"/>
            <child link="camera_optical_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <gazebo reference="camera_optical_joint">
            <disableFixedJointLumping>true</disableFixedJointLumping>
        </gazebo>

        <gazebo reference="camera_link">
            <!-- Sensor name is "camera" (matches the plain, unprefixed
                 convention already used for "lidar"/"imu") and, just like
                 those, has NO explicit <topic> override. gz-sim scopes
                 this sensor's real topic under
                 /world/<world>/model/<name>/link/camera_link/sensor/camera/image
                 on its own  this is the pattern already confirmed
                 working per-robot for lidar/imu once Gazebo starts clean.
                 An explicit relative <topic> here would collide across
                 all 3 robots onto one shared global topic, confirmed via
                 direct testing on the lidar sensor. -->
            <sensor name="camera" type="camera">
                <pose>0 0 0 0 0 0</pose>
                <update_rate>30</update_rate>
                <gz_frame_id>${prefix}/camera_optical_link</gz_frame_id>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>100.0</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
                <always_on>true</always_on>
                <visualize>true</visualize>
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>