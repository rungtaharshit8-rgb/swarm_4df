<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>
    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>
    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>

    <xacro:property name="pi" value="3.1415926535897931"/>

    <xacro:macro name="car_urdf" params="prefix">

        <link name="base_link"></link>

        <joint name="chassis_joint" type="fixed">
            <parent link="base_link"/>
            <child link="chassis"/>
            <origin xyz="-0.3 0 0"/>
        </joint>

        <link name="chassis">
            <visual>
                <origin xyz="0.3 0 0.075"/>
                <geometry>
                    <box size="0.6 0.3 0.15"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin xyz="0.3 0 0.075"/>
                <geometry>
                    <box size="0.6 0.3 0.15"/>
                </geometry>
            </collision>
            <xacro:inertial_box mass="0.5" x="0.6" y="0.3" z="0.15">
                <origin xyz="0.3 0 0.075" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>

        <joint name="left_wheel_back_joint" type="continuous">
            <parent link="base_link"/>
            <child link="left_wheel_back"/>
            <origin xyz="-0.15 0.175 0" rpy="-${pi/2} 0 0" />
            <axis xyz="0 0 1"/>
        </joint>

        <link name="left_wheel_back">
            <visual>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="right_wheel_back_joint" type="continuous">
            <parent link="base_link"/>
            <child link="right_wheel_back"/>
            <origin xyz="-0.15 -0.175 0" rpy="${pi/2} 0 0" />
            <axis xyz="0 0 -1"/>
        </joint>

        <link name="right_wheel_back">
            <visual>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="left_wheel_front_joint" type="continuous">
            <parent link="base_link"/>
            <child link="left_wheel_front"/>
            <origin xyz="0.15 0.175 0" rpy="-${pi/2} 0 0" />
            <axis xyz="0 0 1"/>
        </joint>

        <link name="left_wheel_front">
            <visual>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="right_wheel_front_joint" type="continuous">
            <parent link="base_link"/>
            <child link="right_wheel_front"/>
            <origin xyz="0.15 -0.175 0" rpy="${pi/2} 0 0" />
            <axis xyz="0 0 -1"/>
        </joint>

        <link name="right_wheel_front">
            <visual>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

    </xacro:macro>

</robot>
