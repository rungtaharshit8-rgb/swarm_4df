<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:macro name="car_lidar" params="prefix">

        <link name="lidar_link">
            <visual>
                <geometry>
                    <cylinder radius="0.06" length="0.04"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="0.06" length="0.04"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025"/>
            </inertial>
        </link>

        <joint name="lidar_joint" type="fixed">
            <parent link="base_link"/>
            <child link="lidar_link"/>
            <origin xyz="0 0 0.2" rpy="0 0 0"/>
        </joint>

        <gazebo reference="lidar_joint">
            <disableFixedJointLumping>true</disableFixedJointLumping>
        </gazebo>
        
        <gazebo reference="lidar_link">
            <!-- Sensor name is "lidar" (not "lidar_sensor") and no explicit
                 topic override: gz-sim auto-scopes this sensor's real topic
                 path under .../link/lidar_link/sensor/lidar/scan, which
                 ros_gz_bridge_swarm.yaml maps to "<prefix>/lidar" in ROS. -->
            <sensor name="lidar" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <update_rate>10</update_rate>
                <gz_frame_id>${prefix}/lidar_link</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.15</min>
                        <max>12.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
                <always_on>true</always_on>
                <visualize>false</visualize>
            </sensor>
        </gazebo>

    </xacro:macro>

</robot>
